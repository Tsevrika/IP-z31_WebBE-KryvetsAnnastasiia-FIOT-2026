{
  "name": "recipe-manager-lab4",
  "version": "1.0.0",
  "description": "Recipe Manager REST API with logging, file uploads and performance monitoring",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start server.js --name recipe-manager-lab4",
    "pm2:logs": "pm2 logs recipe-manager-lab4",

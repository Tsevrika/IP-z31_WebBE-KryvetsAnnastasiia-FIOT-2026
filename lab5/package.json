    "passport": "latest",
    "passport-google-oauth20": "latest",
    "sequelize": "latest",
    "uuid": "latest",
    "winston": "latest"
  },
  "devDependencies": {
    "artillery": "^2.0.31",
    "helmet": "^8.1.0",
    "jest": "^30.4.2",
    "node-cache": "^5.1.2",
    "nodemon": "latest",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
